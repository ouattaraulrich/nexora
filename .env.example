# .env.example — Nexora Service Marketplace
# Copier ce fichier en .env et remplir les vraies valeurs
# ⚠️  NE JAMAIS commiter le fichier .env (déjà dans .gitignore)

# Application
APP_ENV=production
APP_NAME=Nexora
APP_URL=https://ton-projet.railway.app

# Base de données MySQL (Railway fournit ces valeurs automatiquement)
DB_HOST=mysql.railway.internal
DB_NAME=railway
DB_USER=root
DB_PASS=your_secret_password
DB_PORT=3306

# API Keys (optionnel)
OPENAI_API_KEY=sk-...
